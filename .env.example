APP_NAME="Berkah POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# PostgreSQL 17 is the only configured database engine in this baseline.
DB_CONNECTION=central
CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=5432
CENTRAL_DB_DATABASE=berkahpos_central
CENTRAL_DB_USERNAME=postgres
CENTRAL_DB_PASSWORD=change-this-local-development-password
CENTRAL_DB_SSLMODE=prefer

# Tenant runtime credentials must be a dedicated restricted PostgreSQL login.
# Never copy CENTRAL_DB_USERNAME/PASSWORD here. Keep the sentinel until a reviewed
# provisioning broker has created a real tenant-scoped login; tenant queries then fail closed.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_DATABASE=berkahpos_tenant
TENANT_DB_USERNAME=__tenant_runtime_role_required__
TENANT_DB_PASSWORD=
TENANT_DB_SSLMODE=prefer

# TENANT_MIGRATOR_DB_* credentials are deliberately omitted from this example.
# They must never be injected into ordinary web or queue runtime services.

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# No Supabase credentials, SDK configuration, or endpoints belong here.
