APP_NAME="Berkah POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
RUN_CENTRAL_MIGRATIONS=false
APP_URL=https://app.berkahtigaputeri.co.id
CENTRAL_DOMAIN=berkahtigaputeri.co.id
CENTRAL_DOMAINS=berkahtigaputeri.co.id,app.berkahtigaputeri.co.id
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=central
MARIADB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
CENTRAL_DB_HOST=mysql
CENTRAL_DB_PORT=3306
CENTRAL_DB_DATABASE=berkahpos_central
CENTRAL_DB_USERNAME=berkahpos_app
CENTRAL_DB_PASSWORD=CHANGE_ME_STRONG_CENTRAL_PASSWORD

TENANT_DB_HOST=mysql
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=berkahpos_app
TENANT_DB_PASSWORD=CHANGE_ME_STRONG_CENTRAL_PASSWORD
TENANT_DB_PREFIX=berkahpos_tenant_

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

# Set these only for an explicitly provisioned first central administrator.
CENTRAL_ADMIN_NAME=
CENTRAL_ADMIN_EMAIL=
CENTRAL_ADMIN_PASSWORD=

# Payment provider keys are secrets; configure them in Coolify, never commit them.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
