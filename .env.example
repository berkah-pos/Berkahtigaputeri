APP_NAME="Berkah POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.berkahtigaputeri.co.id
CENTRAL_DOMAIN=berkahtigaputeri.co.id
CENTRAL_DOMAINS=berkahtigaputeri.co.id,app.berkahtigaputeri.co.id
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=central
CENTRAL_DB_HOST=mysql
CENTRAL_DB_PORT=3306
CENTRAL_DB_DATABASE=berkahpos_central
CENTRAL_DB_USERNAME=berkahpos_app
CENTRAL_DB_PASSWORD=CHANGE_ME_STRONG_CENTRAL_PASSWORD

TENANT_DB_HOST=mysql
TENANT_DB_PORT=3306
TENANT_DB_PREFIX=berkahpos_t_
TENANT_DB_NAME_FORMAT=berkahpos_t_<lowercase-ulid>


# These variables are consumed only by the private tenant-provisioner queue service.
# Do not inject them into app or normal queue services.
PROVISIONER_DB_HOST=mysql
PROVISIONER_DB_PORT=3306
PROVISIONER_DB_DATABASE=information_schema
PROVISIONER_DB_USERNAME=berkahpos_provisioner
PROVISIONER_DB_PASSWORD=CHANGE_ME_STRONG_PROVISIONER_PASSWORD

MIGRATOR_DB_HOST=mysql
MIGRATOR_DB_PORT=3306
MIGRATOR_DB_DATABASE=information_schema
MIGRATOR_DB_USERNAME=berkahpos_migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME_STRONG_MIGRATOR_PASSWORD

# Used only by the MariaDB container/init process. Never inject into app or queue services.
MARIADB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

# Set these only in a controlled first-admin bootstrap command; never in public static assets.
CENTRAL_ADMIN_NAME=
CENTRAL_ADMIN_EMAIL=
CENTRAL_ADMIN_PASSWORD=

# Payment provider keys are secrets; configure them only in a service that needs them.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
