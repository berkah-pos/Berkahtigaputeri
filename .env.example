APP_NAME="Berkah POS"
APP_ENV=local
# Generate a unique local key with: php artisan key:generate --show
# Never copy a local key into staging/production or commit a generated key.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# PostgreSQL 17 is the only configured database engine in this baseline.
# These usernames/passwords are local-development placeholders only.
DB_CONNECTION=central
CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=5432
CENTRAL_DB_DATABASE=berkahpos_central
CENTRAL_DB_USERNAME=postgres
CENTRAL_DB_PASSWORD=change-this-local-development-password
CENTRAL_DB_SSLMODE=prefer

# Tenant runtime credentials must be distinct and are issued by the reviewed
# PostgreSQL provisioning broker. Empty values intentionally fail closed.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_DATABASE=
TENANT_DB_USERNAME=
TENANT_DB_PASSWORD=
TENANT_DB_SSLMODE=verify-full

# Private provisioning-worker only; never inject PROVISIONER_* into web or ordinary
# queue containers. Use a restricted non-superuser role on a maintenance DB.
PROVISIONER_DB_HOST=
PROVISIONER_DB_PORT=5432
PROVISIONER_DB_DATABASE=postgres
PROVISIONER_DB_USERNAME=
PROVISIONER_DB_PASSWORD=
PROVISIONER_DB_SSLMODE=verify-full

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=sync

# Bearer tokens expire after 60 minutes by default; do not disable expiry.
SANCTUM_EXPIRATION_MINUTES=60

# Local development may log mail. Production must configure a real mail transport
# before enabling authentication recovery/verification mail.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=

# No Supabase credentials, SDK configuration, or endpoints belong here.
