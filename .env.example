APP_NAME="Berkah POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# PostgreSQL 17 is the only configured database engine in this baseline.
# These are local-development placeholders, never production runtime credentials.
DB_CONNECTION=central
CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=5432
CENTRAL_DB_DATABASE=berkahpos_central
CENTRAL_DB_USERNAME=postgres
CENTRAL_DB_PASSWORD=change-this-local-central-development-password
CENTRAL_DB_SSLMODE=prefer

# Separate identity by design: do not reuse CENTRAL_DB_USERNAME/PASSWORD.
# This role must be provisioned with tenant-scoped DML grants before tenant access is enabled.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_DATABASE=berkahpos_tenant
TENANT_DB_USERNAME=berkahpos_tenant_runtime
TENANT_DB_PASSWORD=change-this-separate-tenant-runtime-password
TENANT_DB_SSLMODE=prefer

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# No Supabase credentials, SDK configuration, or endpoints belong here.
