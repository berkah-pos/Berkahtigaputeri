APP_NAME="Berkah POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Local Docker Compose bootstrap account. Never reuse these credentials in
# staging/production, and never pass them to the web/ordinary queue service.
POSTGRES_BOOTSTRAP_USERNAME=postgres
POSTGRES_BOOTSTRAP_PASSWORD=change-this-local-bootstrap-password

# Application runtime account. The local db-bootstrap one-shot creates/hardens
# this non-superuser role and grants central-database DML/sequence access only.
DB_CONNECTION=central
CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=5432
CENTRAL_DB_DATABASE=berkahpos_central
CENTRAL_DB_USERNAME=berkahpos_central_runtime
CENTRAL_DB_PASSWORD=change-this-local-runtime-password
CENTRAL_DB_SSLMODE=prefer

# Tenant runtime credentials are different per tenant and are issued by the
# reviewed PostgreSQL provisioning broker. Empty values intentionally fail closed.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_DATABASE=
TENANT_DB_USERNAME=
TENANT_DB_PASSWORD=
TENANT_DB_SSLMODE=verify-full

# Private production provisioning-worker only; never inject PROVISIONER_* into
# web or ordinary queue containers. These are intentionally empty in local .env.
PROVISIONER_DB_HOST=
PROVISIONER_DB_PORT=5432
PROVISIONER_DB_DATABASE=postgres
PROVISIONER_DB_USERNAME=
PROVISIONER_DB_PASSWORD=
PROVISIONER_DB_SSLMODE=verify-full

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# No Supabase credentials, SDK configuration, or endpoints belong here.
