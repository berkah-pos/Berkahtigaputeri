APP_NAME="Berkah POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Local development only. Copy to .env and replace every password.
# The application must never use the PostgreSQL bootstrap/superuser identity.
DB_CONNECTION=central
CENTRAL_DB_HOST=127.0.0.1
CENTRAL_DB_PORT=5432
CENTRAL_DB_DATABASE=berkahpos_central
CENTRAL_DB_USERNAME=berkah_central_runtime
CENTRAL_DB_PASSWORD=replace-with-a-random-local-central-runtime-password
CENTRAL_DB_SSLMODE=prefer

# One local tenant database only; this is not production tenant isolation.
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=5432
TENANT_DB_DATABASE=berkahpos_tenant
TENANT_DB_USERNAME=berkah_tenant_runtime
TENANT_DB_PASSWORD=replace-with-a-random-local-tenant-runtime-password
TENANT_DB_SSLMODE=prefer

# Local Compose bootstrap identity: used only by the PostgreSQL container's
# first-time initialization; never pass these values to app/queue services.
PG_BOOTSTRAP_USERNAME=postgres
PG_BOOTSTRAP_PASSWORD=replace-with-a-random-local-bootstrap-password

# Database-scoped migration identities. Use only in one-shot migration
# commands/services, never in a long-running web or ordinary queue service.
CENTRAL_DB_MIGRATOR_USERNAME=berkah_central_migrator
CENTRAL_DB_MIGRATOR_PASSWORD=replace-with-a-random-local-central-migrator-password
TENANT_DB_MIGRATOR_USERNAME=berkah_tenant_migrator
TENANT_DB_MIGRATOR_PASSWORD=replace-with-a-random-local-tenant-migrator-password

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# No Supabase credentials, SDK configuration, or endpoints belong here.
# Do not use this file or any example password as a Coolify production secret.
